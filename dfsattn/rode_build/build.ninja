ninja_required_version = 1.3
cxx = c++
nvcc = /work/cuda-12.4/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=dfsattn_rode -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1016\" -I/cnic/work/liutt/mywork/attention_time/code/DFSAttn/third_party/RoDe/RoDe -I/cnic/work/liutt/mywork/attention_time/code/DFSAttn/third_party/RoDe/RoDe/utils -I/cnic/work/liutt/mywork/attention_time/code/DFSAttn/third_party/RoDe/RoDe/RoDe_SDDMM -I/cnic/work/liutt/mywork/attention_time/code/DFSAttn/third_party/RoDe/RoDe/RoDe_SpMM -I/cnic/work/liutt/mywork/attention_time/code/DFSAttn/third_party/RoDe/RoDe/third_party/abseil-cpp -isystem /work/liutt/miniconda3/envs/SVG/lib/python3.12/site-packages/torch/include -isystem /work/liutt/miniconda3/envs/SVG/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /work/liutt/miniconda3/envs/SVG/lib/python3.12/site-packages/torch/include/TH -isystem /work/liutt/miniconda3/envs/SVG/lib/python3.12/site-packages/torch/include/THC -isystem /work/cuda-12.4/include -isystem /work/liutt/miniconda3/envs/SVG/include/python3.12 -D_GLIBCXX_USE_CXX11_ABI=1 -fPIC -std=c++17 -O3 -Wno-sign-compare
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=dfsattn_rode -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1016\" -I/cnic/work/liutt/mywork/attention_time/code/DFSAttn/third_party/RoDe/RoDe -I/cnic/work/liutt/mywork/attention_time/code/DFSAttn/third_party/RoDe/RoDe/utils -I/cnic/work/liutt/mywork/attention_time/code/DFSAttn/third_party/RoDe/RoDe/RoDe_SDDMM -I/cnic/work/liutt/mywork/attention_time/code/DFSAttn/third_party/RoDe/RoDe/RoDe_SpMM -I/cnic/work/liutt/mywork/attention_time/code/DFSAttn/third_party/RoDe/RoDe/third_party/abseil-cpp -isystem /work/liutt/miniconda3/envs/SVG/lib/python3.12/site-packages/torch/include -isystem /work/liutt/miniconda3/envs/SVG/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /work/liutt/miniconda3/envs/SVG/lib/python3.12/site-packages/torch/include/TH -isystem /work/liutt/miniconda3/envs/SVG/lib/python3.12/site-packages/torch/include/THC -isystem /work/cuda-12.4/include -isystem /work/liutt/miniconda3/envs/SVG/include/python3.12 -D_GLIBCXX_USE_CXX11_ABI=1 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_90,code=sm_90 --compiler-options '-fPIC' -O3 --use_fast_math -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -L/work/liutt/miniconda3/envs/SVG/lib/python3.12/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/work/cuda-12.4/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags



rule link
  command = $cxx $in $ldflags -o $out

build rode_bridge.cuda.o: cuda_compile /cnic/work/liutt/mywork/attention_time/code/DFSAttn/dfsattn/rode_bridge.cu
build RoDeSddmm.cuda.o: cuda_compile /cnic/work/liutt/mywork/attention_time/code/DFSAttn/third_party/RoDe/RoDe/RoDe_SDDMM/RoDeSddmm.cu
build RoDeSpmm.cuda.o: cuda_compile /cnic/work/liutt/mywork/attention_time/code/DFSAttn/third_party/RoDe/RoDe/RoDe_SpMM/RoDeSpmm.cu



build dfsattn_rode.so: link rode_bridge.cuda.o RoDeSddmm.cuda.o RoDeSpmm.cuda.o

default dfsattn_rode.so
